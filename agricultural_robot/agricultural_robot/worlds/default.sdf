<?xml version="1.0"?>
<sdf version="1.8">
  <world name="inspection">

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <sky></sky>
      <grid>false</grid>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.35 0.45 0.25 1</ambient>
            <diffuse>0.35 0.45 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cartello ArUco: a terra (Z=0), 0.5 m a destra del robot, rivolto verso il robot.
         Il marker guarda verso -X del modello: yaw -90° lo fa guardare verso +Y, cioè verso l'origine. -->
    <include>
      <uri>model://aruco_tag</uri>
      <name>aruco_tag</name>
      <pose>0.0 1 0 0 0 1.5708</pose>
    </include>

  </world>
</sdf>
