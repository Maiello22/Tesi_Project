<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="armando_4dof">

  <!-- ========================================================================= -->
  <!-- MATERIALI (Grigio/Bianco/Nero come da modello di riferimento) -->
  <!-- ========================================================================= -->
  <material name="robot_white">
    <color rgba="0.85 0.85 0.85 1.0"/>
  </material>

  <material name="robot_grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="robot_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- ========================================================================= -->
  <!-- WORLD LINK -->
  <!-- ========================================================================= -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================================= -->
  <!-- BASE LINK -->
  <!-- ========================================================================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.25 0.2 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <material name="robot_white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.25 0.2 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.008"/>
    </inertial>    
  </link>

  <!-- ========================================================================= -->
  <!-- DOF 1: GIUNTO j0 - Rotazione della base (Asse Z) -->
  <!-- ========================================================================= -->
  <joint name="j0" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_turret"/>
    <origin xyz="0.06 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" velocity="1.0" lower="-2.57" upper="2.57"/>
  </joint>

  <link name="shoulder_turret">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <material name="robot_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- ========================================================================= -->
  <!-- DOF 2: GIUNTO j1 - Spalla (Asse Y) -->
  <!-- ========================================================================= -->
  <joint name="j1" type="revolute">
    <parent link="shoulder_turret"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="300" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="upper_arm">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.25"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.125"/>
      <material name="robot_white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.25"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.125"/>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Snodo circolare spalla-gomito -->
  <joint name="joint_elbow_visual" type="fixed">
    <parent link="upper_arm"/>
    <child link="elbow_disc"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="elbow_disc">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.045"/>
      </geometry>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <material name="robot_grey"/>
    </visual>
  </link>

  <!-- ========================================================================= -->
  <!-- DOF 3: GIUNTO j2 - Gomito (Asse Y) -->
  <!-- ========================================================================= -->
  <joint name="j2" type="revolute">
    <parent link="elbow_disc"/>
    <child link="forearm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="300" velocity="1.0" lower="-2.0" upper="2.0"/>
  </joint>

  <link name="forearm">
    <visual>
      <geometry>
        <box size="0.22 0.038 0.038"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.11 0 0"/>
      <material name="robot_white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.22 0.038 0.038"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.11 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Snodo circolare gomito-polso -->
  <joint name="joint_wrist_visual" type="fixed">
    <parent link="forearm"/>
    <child link="wrist_disc"/>
    <origin xyz="0.22 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wrist_disc">
    <visual>
      <geometry>
        <cylinder radius="0.022" length="0.042"/>
      </geometry>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <material name="robot_grey"/>
    </visual>
  </link>

  <!-- ========================================================================= -->
  <!-- DOF 4: GIUNTO j3 - Polso (Asse Y) -->
  <!-- ========================================================================= -->
  <joint name="j3" type="revolute">
    <parent link="wrist_disc"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <!-- ========================================================================= -->
  <!-- END EFFECTOR (Supporto per il montaggio della telecamera) -->
  <!-- ========================================================================= -->
  <link name="end_effector">
    <visual>
      <geometry>
        <box size="0.10 0.035 0.035"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
      <material name="robot_white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.10 0.035 0.035"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="0.00004" ixy="0.0" ixz="0.0" iyy="0.00015" iyz="0.0" izz="0.00015"/>
    </inertial>
  </link>

  <!-- ========================================================================= -->
  <!-- CAMERA LINK (Montata direttamente in testa all'End Effector) -->
  <!-- ========================================================================= -->
  <joint name="camera_joint" type="fixed">
    <parent link="end_effector"/>
    <child link="camera_link"/>
    <!-- Posizionata sulla parte frontale avanzata dell'end effector -->
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.035 0.025"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0125 0 0"/>
      <material name="robot_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.035 0.025"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0125 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- Frame ottico ROS per l'orientamento corretto del flusso video -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0.025 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="camera_optical_link"/>

  <!-- ========================================================================= -->
  <!-- GAZEBO PLUGINS & MATERIALI GAZEBO -->
  <!-- ========================================================================= -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find agricultural_robot)/config/arm2_controllers.yaml</parameters>
      <control_period>0.01</control_period>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="shoulder_turret">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="upper_arm">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="elbow_disc">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="forearm">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="wrist_disc">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="end_effector">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="camera" type="camera">
      <camera>
        <horizontal_fov>1.5708</horizontal_fov> // 90 gradi
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ========================================================================= -->
  <!-- ROS2 CONTROL (4 Giunti attuati: j0, j1, j2, j3) -->
  <!-- ========================================================================= -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="j0">
      <command_interface name="position">
        <param name="min">-2.57</param>
        <param name="max">2.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="j1">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="j2">
      <command_interface name="position">
        <param name="min">-2.0</param>
        <param name="max">2.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="j3">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>